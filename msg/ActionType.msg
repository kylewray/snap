# This is a list of the actions available as ROS services, as well
# as special actions that the robot takes.

# Special Actions:
uint8 NONE = 0
uint8 RECOVERY = 1
uint8 TELEOPERATOR = 2

# Service Actions:
uint8 MOVE = 100
uint8 MOVE_IN_GRID = 101
uint8 NAVIGATE = 102
uint8 NAVIGATE_TO_REGION = 103
uint8 PUSH = 104
uint8 ALIGN = 105

