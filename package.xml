<?xml version="1.0"?>
<package format="2">
  <name>snap</name>
  <version>0.2.0</version>
  <description>A controller node for a Kobuki, with straight-forward 'nova' and 'epic' integration, making robot research a snap.</description>
  <maintainer email="wray@cs.umass.edu">Kyle Hollins Wray</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <depend>ar_track_alvar_msgs</depend>

  <depend>message_generation</depend>
  <depend>message_runtime</depend>

  <depend>epic</depend>

  <export>
  </export>

</package>
