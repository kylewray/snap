<?xml version="1.0" ?>
<launch>
<!-- <param name="/use_sim_time" value="true" /> -->

  <arg name="map_name" default="$(find breakfast)/maps/simple.yaml" />

  <node pkg="map_server" type="map_server" name="map_server" output="screen" args="$(arg map_name)" />

  <include file="$(find breakfast)/launch/robot.launch" />

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find breakfast)/rviz/default.rviz" />

</launch>


